                "field_body_text": [
                    {
                        "value": "<section class=\"container-fluid section page-intro mt-5\"><div class=\"container\"><h1>FSHD Community Speaks to Dyne Team on World FSHD Day</h1><div class=\"ratio ratio-16x9\"><iframe title=\"FSHD Community Speaks to Dyne Team on World FSHD Day\" src=\"https://player.vimeo.com/video/430827122\" width=\"640\" height=\"360\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\" loading=\"lazy\"></iframe></div><p><a href=\"https://vimeo.com/430827122\" target=\"_blank\" rel=\"noopener noreferrer\">Watch the FSHD Day video on Vimeo</a></p></div></section>",
                        "format": "dyne_legacy_html"
                    }
                ],
