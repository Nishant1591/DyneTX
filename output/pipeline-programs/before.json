                        "value": "{\"id\":1124,\"type\":\"page\",\"status\":\"publish\",\"password_protected\":false,\"title\":\"FSHD DAY\",\"slug\":\"fshd-day\",\"parent\":0,\"date\":\"2020-06-19 16:24:08\",\"modified\":\"2021-01-22 11:20:25\",\"order\":34,\"mime\":\"\",\"content\":\"\",\"excerpt\":\"\",\"content_suppressed\":false,\"source_content_characters\":0,\"meta\":{\"flexible_content\":\"a:2:{i:0;s:25:\\\"interior_page_header_band\\\";i:1;s:12:\\\"wysiwyg_band\\\";}\",\"flexible_content_0_title\":\"FSHD Community Speaks to Dyne Team on World FSHD Day\",\"flexible_content_0_background_image\":\"755\",\"flexible_content_1_content\":\"<p style=\\\"text-align: center;\\\"><iframe src=\\\"https://player.vimeo.com/video/430827122\\\" width=\\\"640\\\" height=\\\"360\\\" frameborder=\\\"0\\\" allowfullscreen=\\\"allowfullscreen\\\"></iframe></p>\",\"_wp_page_template\":\"default\",\"first_line\":\"\",\"second_line\":\"\",\"third_line\":\"\",\"_yoast_wpseo_title\":\"%%title%% %%page%%\",\"_yoast_wpseo_opengraph-image\":\"https://www.dyne-tx.com/wp-content/uploads/hero-focus-fshd-social.jpg\",\"_yoast_wpseo_twitter-image\":\"https://www.dyne-tx.com/wp-content/uploads/hero-focus-fshd-social.jpg\"},\"terms\":[],\"classification\":\"unmigrated_editorial\",\"disposition\":\"Preserve original visibility without exposing archived test/duplicate/placeholder content publicly\",\"drupal_alias\":null,\"drupal_bundle\":null}"
