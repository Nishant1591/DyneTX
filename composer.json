{
    "name": "dyne-tx/drupal",
    "description": "Dyne Therapeutics — WordPress (dynetxdev2020) to Drupal 11 as-is migration.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://www.drupal.org/project/drupal",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.0",
        "drupal/admin_toolbar": "^3.6",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/bootstrap5": "^4.0",
        "drupal/ckeditor5_premium_features": "^1.8",
        "drupal/colorbox": "^2.0",
        "drupal/core-composer-scaffold": "11.4.11",
        "drupal/core-project-message": "11.4.11",
        "drupal/core-recommended": "11.4.11",
        "drupal/eu_cookie_compliance": "^1.29",
        "drupal/external_link_popup": "^2.0",
        "drupal/layout_builder_restrictions": "^3.0",
        "drupal/metatag": "^2.2",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_source_csv": "^3.8",
        "drupal/migrate_tools": "^6.1",
        "drupal/paragraphs": "^1.23",
        "drupal/pathauto": "^1.15",
        "drupal/redirect": "^1.13",
        "drupal/robotstxt": "^1.6",
        "drupal/social_media_links": "^2.10",
        "drupal/video_embed_field": "^3.1",
        "drupal/webform": "^6.3.1",
        "drupal/xmlsitemap": "^2.0",
        "drush/drush": "^13"
    },
    "require-dev": {
        "drupal/core-dev": "11.4.11"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[project-root]/.gitattributes": false,
                "[web-root]/robots.txt": false
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@composer drupal:scaffold"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    }
}
