{# Rich text section component: WP article/content blocks with optional icon+link. #}
{% if paragraph.field_style.value == 'legacy-markup' %}
  <div class="dyne-legacy-content">{{ content.field_body_text }}</div>
{% else %}
<section class="dyne-rich-text container py-5">
  <div class="row">
    <div class="col-12">
      {% if paragraph.field_anchor.value %}<a id="{{ paragraph.field_anchor.value }}" class="scroll-anchor"></a>{% endif %}
      {% if paragraph.field_heading.value %}<h2 class="h1 {{ paragraph.field_style.value }}">{{ paragraph.field_heading.value }}</h2>{% endif %}
      {% if paragraph.field_icon.value %}<img src="{{ paragraph.field_icon.value }}" alt="" class="card-img-top mb-3" />{% endif %}
      {{ content.field_body_text }}
      {% if paragraph.field_link.title %}<p class="dyne-rich-text__link">{{ content.field_link }}</p>{% endif %}
    </div>
  </div>
</section>
{% endif %}
