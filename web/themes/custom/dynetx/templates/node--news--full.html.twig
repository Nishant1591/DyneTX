{{ dyne_metadata_cache }}
<article{{ attributes.addClass('dyne-news-detail', 'wrapper', 'pages').addClass(dyne_page_classes|default([])) }}>
  <div class="hero hero-third-level" aria-hidden="true"></div>
  <div class="container py-5">
    {{ title_prefix }}<h1>{{ label }}</h1>{{ title_suffix }}
    {% if dyne_native_details.date %}<p class="dyne-news-detail__date"><time datetime="{{ dyne_native_details.date }}Z">{{ dyne_native_details.date|date('F j, Y', 'UTC') }}</time></p>{% endif %}
    {{ content.field_image }}
    <div class="dyne-legacy-content">{{ content.field_body_text }}</div>
    {% if dyne_native_details.url and dyne_native_details.type == 'url' %}
      <p><a href="{{ dyne_native_details.url }}" target="_blank" rel="noopener noreferrer">{{ 'Read the original release'|t }}</a></p>
    {% elseif dyne_native_details.url and dyne_native_details.type == 'file' %}
      <p><a href="{{ dyne_native_details.url }}" download><span aria-hidden="true">↓</span> {{ 'Download publication'|t }}</a></p>
    {% endif %}
    <p class="mt-4"><a href="{{ path('<front>') }}#latest-news">{{ 'Latest news'|t }}</a></p>
  </div>
</article>
