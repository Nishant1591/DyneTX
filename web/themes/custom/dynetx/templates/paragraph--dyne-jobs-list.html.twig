{# Drupal job records use the original positions layout and native filters. #}
<div{{ attributes.addClass('dyne-jobs').setAttribute('id', paragraph.field_anchor.value|default('')).setAttribute('data-dyne-jobs-source', dyne_use_job_records ? 'content' : 'paragraph') }}>
  {{ dyne_job_cache }}
  {% if (paragraph.field_heading.value and not dyne_legacy) or paragraph.field_body_text.value %}
    <div class="container">
      {% if paragraph.field_heading.value and not dyne_legacy %}<h2 class="h1">{{ paragraph.field_heading.value }}</h2>{% endif %}
      {% if paragraph.field_body_text.value %}<div class="dyne-jobs__intro">{{ content.field_body_text }}</div>{% endif %}
    </div>
  {% endif %}
  {% if dyne_use_job_records %}
    <div class="container-fluid section positions_filter">
      <div class="container"><div class="row">
        <div class="col-6">
          <label for="dyne-department-{{ paragraph.id() }}">{{ 'Department'|t }}</label>
          <select id="dyne-department-{{ paragraph.id() }}" data-dyne-job-filter="department">
            <option value="">{{ 'ALL'|t }}</option>
            {% for department in dyne_job_departments %}<option value="{{ department.filter_key }}">{{ department.label }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-6">
          <label for="dyne-location-{{ paragraph.id() }}">{{ 'Location'|t }}</label>
          <select id="dyne-location-{{ paragraph.id() }}" data-dyne-job-filter="location">
            <option value="">{{ 'ALL'|t }}</option>
            {% for location in dyne_job_locations %}<option value="{{ location.filter_key }}">{{ location.label }}</option>{% endfor %}
          </select>
        </div>
      </div></div>
    </div>
    <div class="container-fluid section positions">
      <div class="container"><div class="row"><div class="col-12">
        <div class="accordion md-accordion">
          {% for group in dyne_job_groups %}
            <div class="dyne-jobs-group" data-dyne-job-group="{{ group.filter_key }}">
              <h3 class="category">{{ group.label|upper }}</h3>
              {% for job in group.jobs %}
                <div class="card" data-dyne-job-location="{{ job.location_filter }}">
                  <div class="card-header">
                    <a class="collapsed" href="{{ job.url }}">
                      <h5 class="mb-0">{{ job.title }}</h5>
                      <span class="btn btn-primary btn-plus" aria-hidden="true"><i></i></span>
                    </a>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <p>{{ 'There are no open positions at this time.'|t }}</p>
          {% endfor %}
        </div>
        {% if dyne_job_groups %}<p data-dyne-jobs-empty hidden>{{ 'No open positions match these filters.'|t }}</p>{% endif %}
      </div></div></div>
    </div>
  {% else %}
    <div class="container"><ul class="list-group">
      {% for job in dyne_items %}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span><a href="{{ job.url }}">{{ job.title }}</a><br /><small>{{ job.department }} · {{ job.location }}</small></span>
          <a href="{{ job.url }}" class="btn btn-primary">{{ 'Apply'|t }}</a>
        </li>
      {% endfor %}
    </ul></div>
  {% endif %}
</div>
