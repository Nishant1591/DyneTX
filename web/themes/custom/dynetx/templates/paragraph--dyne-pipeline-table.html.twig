{# Pipeline table component: WP interactive pipeline grid. #}
{# Rows JSON: [{disease, prevalence, target, phase, status, url}] #}
<section class="dyne-pipeline container py-5">
  {% if paragraph.field_heading.value %}<h2 class="h1">{{ paragraph.field_heading.value }}</h2>{% endif %}
  <table class="pipeline-table">
    <thead><tr><th>Disease &amp; prevalence / target</th><th>Target</th><th>Preclinical</th><th>Clinical</th><th>Registrational</th><th>Status</th></tr></thead>
    <tbody>
      {% for row in dyne_rows %}
        <tr>
          <td><a href="{{ row.url }}">{{ row.disease }}</a><br /><small>{{ row.prevalence }}</small></td>
          <td>{{ row.target }}</td>
          <td colspan="3">{{ row.phase }}</td>
          <td>{{ row.status }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</section>
