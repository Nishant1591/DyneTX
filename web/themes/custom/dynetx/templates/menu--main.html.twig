{# Menu: main header nav renders Drupal menu tree with WP navbar classes.
   Top-level links come from Drupal URLs (internal:/about-us etc); dropdowns
   use .dropdown-menu/.dropdown-item to match live site. #}
{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0) }}
{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('navbar-nav', 'me-auto') }}>
    {% else %}
      <div class="dropdown-menu dropdown-primary">
    {% endif %}
    {% for item in items %}
      {% set is_expanded = item.below is not empty %}
      {% if menu_level == 0 %}
        <li class="nav-item{{ is_expanded ? ' dropdown' : '' }}">
          <a href="{{ item.url }}" class="nav-link{{ is_expanded ? ' dropdown-toggle' : '' }}{{ item.in_active_trail ? ' active' : '' }}"{{ is_expanded ? ' aria-haspopup="true" aria-expanded="false"' : '' }}{{ item.url.external and not is_expanded ? ' data-dyne-exit data-dyne-exit-target="_blank"' : '' }}><span>{% if item.title == 'FORCE™ Platform' %}FORCE<sup>TM</sup> Platform{% else %}{{ item.title }}{% endif %}</span></a>
          {% if is_expanded %}{{ menus.menu_links(item.below, attributes, menu_level + 1) }}{% endif %}
        </li>
      {% else %}
        <a href="{{ item.url }}" class="dropdown-item">{{ item.title }}</a>
        {% if is_expanded %}{{ menus.menu_links(item.below, attributes, menu_level + 1) }}{% endif %}
      {% endif %}
    {% endfor %}
    {% if menu_level == 0 %}</ul>{% else %}</div>{% endif %}
  {% endif %}
{% endmacro %}
