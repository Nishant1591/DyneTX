<article{{ attributes.addClass('dyne-leader-detail', 'wrapper', 'pages').addClass(dyne_page_classes|default([])) }}>
  <div class="hero hero-third-level" aria-hidden="true"></div>
  <div class="container py-5">
    {{ title_prefix }}<h1>{{ label }}</h1>{{ title_suffix }}
    <div class="row g-4">
      {% if not node.field_image.isEmpty() %}<div class="col-12 col-md-4 dyne-leader-detail__image">{{ content.field_image }}</div>{% endif %}
      <div class="col-12 col-md">
        {% if dyne_leader_role %}<p><strong>{{ dyne_leader_role }}</strong></p>{% endif %}
        <div class="dyne-legacy-content">{{ content.field_body_text }}</div>
        {{ content.field_link }}
        <p class="mt-4"><a href="{{ path('<front>') }}about-us/#leadership">{{ 'Meet our team'|t }}</a></p>
      </div>
    </div>
  </div>
</article>
