{# Metadata is loaded from the source archive by the Drupal migration. #}
{% set asset_base = path('<front>') ~ directory ~ '/images/' %}
{% if dyne_is_home %}
  <section class="hero hero-media dyne-home-hero" aria-label="{{ 'Expanding what is possible'|t }}">
    <picture class="dyne-home-hero-still">
      <source media="(orientation: landscape)" srcset="{{ asset_base }}hero/hero-home-desktop-lastframe.webp" />
      <img src="{{ asset_base }}hero/hero-home-mobile-lastframe.webp" alt="{{ 'Dyne Therapeutics: expanding what is possible for people living with neuromuscular diseases'|t }}" fetchpriority="high" />
    </picture>
    <video class="hero-video" data-dyne-home-video muted playsinline preload="none" aria-hidden="true"
      data-desktop-src="{{ asset_base }}hero/hero-home-desktop.mp4"
      data-mobile-src="{{ asset_base }}hero/hero-home-mobile.mp4"
      data-desktop-poster="{{ asset_base }}hero/hero-home-desktop.webp"
      data-mobile-poster="{{ asset_base }}hero/hero-home-mobile.webp"></video>
    <button class="dyne-hero-motion" type="button" data-dyne-hero-motion hidden>{{ 'Pause animation'|t }}</button>
  </section>
{% elseif dyne_hero.classes == 'perspectives' %}
  <div class="hero perspectives dyne-perspectives-hero">
    <div class="hero-title-2">{{ 'perspectives'|t }}</div>
    <div class="hero-subtitle">{{ 'We are passionate about using our voices to advance our mission of developing life-transforming therapies for people living with serious muscle diseases.'|t }}</div>
  </div>
{% elseif dyne_hero.third_level %}
  <div class="hero hero-third-level" aria-hidden="true"></div>
{% elseif dyne_hero.desktop %}
  <div class="hero hero-secondary {{ dyne_hero.classes|default('') }}">
    <div class="hero-bg-base bg-img">
      <picture>
        {% if dyne_hero.mobile %}<source srcset="{{ dyne_hero.mobile }}" media="(max-width: 767.98px)" />{% endif %}
        <img src="{{ dyne_hero.desktop }}" alt="" fetchpriority="high" />
      </picture>
    </div>
    {% if dyne_hero.line1 %}<p class="h1-secondary-1">{{ dyne_hero.line1|striptags }}</p>{% endif %}
    {% if dyne_hero.overlay %}<div class="hero-bg-overlay bg-img"><img src="{{ dyne_hero.overlay }}" alt="" /></div>{% endif %}
    {% if dyne_hero.line2 %}<p class="h1-secondary-2">{{ dyne_hero.line2|striptags }}</p>{% endif %}
  </div>
{% endif %}
