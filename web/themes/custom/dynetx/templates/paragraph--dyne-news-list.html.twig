{# Structured news entries keep the original home news panel and editable data. #}
{% if dyne_is_home %}
  <section{{ attributes.setAttribute('id', 'latest-news').addClass('container-fluid', 'section', 'section-news', 'bg-deep-blue', 'facelifting') }}>
    <div class="bg-img bg-img-left">
      <picture>
        <source srcset="{{ path('<front>') ~ directory }}/images/news/news-mobile@2x.webp" media="(max-width: 767.98px)" />
        <source srcset="{{ path('<front>') ~ directory }}/images/news/news-desktop@2x.webp" media="(min-resolution: 1.5dppx)" />
        <img src="{{ path('<front>') ~ directory }}/images/news/news-desktop.webp" alt="{{ 'Dyne Therapeutics office building'|t }}" />
      </picture>
    </div>
    <div class="container"><div class="row">
      <div class="col-md-6 offset-md-6 col-lg-7 offset-lg-5 offset-xl-4 section-news-content">
        <h2 class="h2 h2-new h2-new-light"><span>{{ 'Latest'|t }}</span> <span class="h2-new-medium">{{ 'news'|t }}</span></h2>
        {% for item in dyne_items %}
          <div class="section-news-item">
            <p class="section-news-date">{{ item.date }}</p>
            <a class="section-news-item-title" href="{{ item.url }}">{{ item.title }}</a>
            <a class="btn btn-primary btn-lg" href="{{ item.url }}">{{ 'Read more'|t }}</a>
          </div>
        {% endfor %}
      </div>
    </div></div>
  </section>
{% else %}
  <section{{ attributes.addClass('dyne-news-list', 'container', 'py-5') }}>
    {% if paragraph.field_heading.value %}<h2 class="h1">{{ paragraph.field_heading.value }}</h2>{% endif %}
    {% for item in dyne_items %}
      <div class="col-12 card news-short">
        <div class="row card-body align-items-center">
          <h3 class="h4 col-12 col-md-3 card-title text-nowrap">{{ item.date }}</h3>
          <p class="col card-text"><a href="{{ item.url }}">{{ item.title }}</a></p>
          <div class="col-12 col-md-auto"><a href="{{ item.url }}" class="btn btn-primary stretched-link">{{ 'Read more'|t }}</a></div>
        </div>
      </div>
    {% endfor %}
  </section>
{% endif %}
