{{ dyne_component_cache }}
{# Native program sections: Onset, Cause, Symptoms, and Unmet need. #}
<section class="dyne-drug container py-5">
  {% if paragraph.field_heading.value %}<h2 class="h1">{{ paragraph.field_heading.value }}</h2>{% endif %}
  {{ paragraph.field_body_text.value|raw }}
  {% for s in dyne_sections %}
    <h3>{{ s.title }}</h3>
    {% if s.rich %}<div>{{ s.body }}</div>{% else %}<p>{{ s.body }}</p>{% endif %}
  {% endfor %}
</section>
