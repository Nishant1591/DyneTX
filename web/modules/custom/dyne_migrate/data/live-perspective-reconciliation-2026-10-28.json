          "operation": "cached_public_social_post",
          "reviewed_after_value": "\r\n\r\n\t\t\r\n\t\t\t\t\r\n\t\t<div class=\"container-fluid section perspective-socials\">\r\n\t\t\t<div class=\"container\">\r\n\t\t\t\t<div class=\"row\">\r\n\r\n\t\t\t\t\t<div class=\"col-12 col-sm-7\">\r\n\t\t\t\t\t\tStay connected with us on <br></br>LinkedIn, X and Facebook.\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<div class=\"col-8 col-sm-5\">\r\n\t\t\t\t\t\t<a class=\"nav-link  mr-2 mr-md-3\" target=\"_blank\" title=\"opens in a new window\" href=\"https://www.linkedin.com/company/dynetx\" rel=\"noopener\"><i class=\"ico-in-grn\"></i><span class=\"sr-only\">www.linkedin.com</span></a>\r\n\t\t\t\t\t\t<a class=\"nav-link  mr-2 mr-md-3\" target=\"_blank\" title=\"opens in a new window\" href=\"https://twitter.com/dyne_tx\" rel=\"noopener\"><i class=\"ico-tw-grn\"></i><span class=\"sr-only\">twitter.com</span></a>\r\n\t\t\t\t\t\t<a class=\"nav-link\" target=\"_blank\" title=\"opens in a new window\" href=\"https://www.facebook.com/DyneTherapeutic/\" rel=\"noopener\"><i class=\"ico-fb-grn\"></i><span class=\"sr-only\">www.facebook.com</span></a> \r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t\t\t\t\r\n\t\t<div class=\"container-fluid section twitter-feeds\">\n\t\t\t<div class=\"container\">\n\t\t\t\t<div class=\"row\">\n\n\t\t\t\t\t<div class=\"col-12 col-sm-6 mb-5 mb-sm-0\">\n\t\t\t\t\t\t<h2>Hear more from Dyne Therapeutics</h2>\n\n<!-- Custom Twitter Feeds by Smash Balloon -->\n<div id=\"dyne-cached-social-post\" role=\"region\" aria-label=\"Twitter Feed\" class=\" ctf ctf-type-usertimeline ctf-rebranded ctf-feed-933402064  ctf-styles ctf-list ctf-regular-style dyne-social-snapshot\">\n        <div class=\"ctf-tweets\" role=\"list\">\n   \t\t\n<div role=\"listitem\" class=\"ctf-item ctf-author-dyne_tx ctf-new ctf-hide-avatar\" id=\"2105027363960463397\">\n\n\t\n\t<div class=\"ctf-author-box\">\n\t\t<div class=\"ctf-author-box-link\">\n\t        \t\t\t\t\n\t\t\t\t\t\t\t\t\t<h3 class=\"ctf-author-name-heading\"><a href=\"https://twitter.com/dyne_tx\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ctf-author-name\">Dyne Therapeutics</a></h3>\n\t\t\t\t\t\t\t\t\t\t<a href=\"https://twitter.com/dyne_tx\" class=\"ctf-author-screenname\" target=\"_blank\" rel=\"noopener noreferrer\">@dyne_tx</a>\n\t\t\t\t\t<span class=\"ctf-screename-sep\">·</span>\n\t\t\t\t\t        \n\t\t\t\t\t\t\t<div class=\"ctf-tweet-meta\">\n\t\t\t\t\t<a href=\"https://twitter.com/dyne_tx/status/2105027363960463397\" class=\"ctf-tweet-date\" target=\"_blank\" rel=\"noopener noreferrer\">29 Sep</a>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t    \n\t</div>\n\t<div class=\"ctf-tweet-content\">\n\t\t                <p class=\"ctf-tweet-text\">\n                                        Today we announced additional one-year data from the Phase 1/2 ACHIEVE trial of z-basivarsen (DYNE-101) for DM1. We're pleased to share these results at both #WMS2026 and #AANEM2026. Read more: https://bit.ly/4iQUleP                                                         </p>\n            \t</div>\n\n\t\t\n\t<div class=\"ctf-tweet-actions\">\n\t\t\n\t\t<a href=\"https://twitter.com/intent/tweet?in_reply_to=2105027363960463397&amp;related=dyne_tx\" class=\"ctf-reply\" target=\"_blank\" rel=\"noopener noreferrer\">\n\t\t\t<svg class=\"svg-inline--fa fa-w-16\" viewbox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\"><g><path fill=\"currentColor\" d=\"M14.046 2.242l-4.148-.01h-.002c-4.374 0-7.8 3.427-7.8 7.802 0 4.098 3.186 7.206 7.465 7.37v3.828c0 .108.044.286.12.403.142.225.384.347.632.347.138 0 .277-.038.402-.118.264-.168 6.473-4.14 8.088-5.506 1.902-1.61 3.04-3.97 3.043-6.312v-.017c-.006-4.367-3.43-7.787-7.8-7.788zm3.787 12.972c-1.134.96-4.862 3.405-6.772 4.643V16.67c0-.414-.335-.75-.75-.75h-.396c-3.66 0-6.318-2.476-6.318-5.886 0-3.534 2.768-6.302 6.3-6.302l4.147.01h.002c3.532 0 6.3 2.766 6.302 6.296-.003 1.91-.942 3.844-2.514 5.176z\"></path></g></svg>\t\t\t<span class=\"ct