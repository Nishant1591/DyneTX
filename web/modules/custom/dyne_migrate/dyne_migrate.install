/**
 * Ensure migrated job descriptions use a restricted, available text format.
 */
function _dyne_migrate_job_text_format(): void {
  if (\Drupal\filter\Entity\FilterFormat::load('dyne_job_html')) {
    return;
  }

  \Drupal\filter\Entity\FilterFormat::create([
    'format' => 'dyne_job_html',
    'name' => 'Restricted HTML',
    'weight' => 10,
    'roles' => ['authenticated'],
    'filters' => [
      'filter_html' => [
        'id' => 'filter_html',
        'provider' => 'filter',
        'status' => TRUE,
        'weight' => 0,
        'settings' => [
          'allowed_html' => '<a href target rel title> <section class> <h3> <p class> <ul> <li> <strong> <em>',
          'filter_html_help' => FALSE,
          'filter_html_nofollow' => FALSE,
        ],
      ],
    ],
  ])->save();
}

/**
 * Ensure the job bundle has fields and displays for a complete job detail.
 */
function _dyne_migrate_job_detail_fields(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $field_storage = $entity_type_manager->getStorage('field_storage_config');
  $field_config = $entity_type_manager->getStorage('field_config');
  $definitions = [
    'field_body_text' => ['text_long', [], 'Job description'],
    'field_department_text' => ['string', ['max_length' => 255], 'Department'],
    'field_location_text' => ['string', ['max_length' => 255], 'Location'],
    'field_apply_url' => ['string', ['max_length' => 2048], 'Application URL'],
    'field_previous_url' => ['string', ['max_length' => 2048], 'Previous job URL'],
    'field_next_url' => ['string', ['max_length' => 2048], 'Next job URL'],
    'field_department_group' => ['string', ['max_length' => 128], 'Careers department group'],
    'field_open_position_weight' => ['integer', [], 'Open position order within department'],
  ];

  foreach ($definitions as $field_name => [$type, $settings, $label]) {
    $storage_id = 'node.' . $field_name;
    if (!$field_storage->load($storage_id)) {
      $field_storage->create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $type,
        'settings' => $settings,
        'cardinality' => 1,
        'translatable' => FALSE,
      ])->save();
    }

    if (!$field_config->load('node.job.' . $field_name)) {
      $field_config->create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => 'job',
        'label' => $label,
        'settings' => $settings,
        'required' => FALSE,
        'translatable' => FALSE,
      ])->save();
    }
  }

  $form_display = EntityFormDisplay::load('node.job.default');
  if (!$form_display) {
    $form_display = EntityFormDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'job',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $form_widgets = [
    'field_department_text' => 'string_textfield',
    'field_location_text' => 'string_textfield',
    'field_apply_url' => 'string_textfield',
    'field_body_text' => 'text_textarea',
    'field_previous_url' => 'string_textfield',
    'field_next_url' => 'string_textfield',
    'field_department_group' => 'string_textfield',
    'field_open_position_weight' => 'number',
  ];
  $hidden = $form_display->get('hidden') ?: [];
  $hidden = array_fill_keys(array_is_list($hidden) ? $hidden : array_keys($hidden), TRUE);
  $weight = 0;
  foreach ($form_widgets as $field_name => $widget) {
    if (!$field_config->load('node.job.' . $field_name)) {
      continue;
    }
    $form_display->setComponent($field_name, ['type' => $widget, 'weight' => $weight++]);
    unset($hidden[$field_name]);
  }
  $form_display->set('hidden', $hidden);
  $form_display->save();

  $view_display = EntityViewDisplay::load('node.job.default');
  if (!$view_display) {
    $view_display = EntityViewDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'job',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $view_formatters = [
    'field_department_text' => 'string',
    'field_location_text' => 'string',
    'field_apply_url' => 'string',
    'field_body_text' => 'text_default',
    'field_previous_url' => 'string',
    'field_next_url' => 'string',
    'field_department_group' => 'string',
    'field_open_position_weight' => 'number_integer',
  ];
  $hidden = $view_display->get('hidden') ?: [];
  $hidden = array_fill_keys(array_is_list($hidden) ? $hidden : array_keys($hidden), TRUE);
  $weight = 0;
  foreach ($view_formatters as $field_name => $formatter) {
    if (!$field_config->load('node.job.' . $field_name)) {
      continue;
    }
    $view_display->setComponent($field_name, [
      'type' => $formatter,
      'label' => 'hidden',
      'weight' => $weight++,
    ]);
    unset($hidden[$field_name]);
  }
  $view_display->set('hidden', $hidden);
  $view_display->save();
}

/**
 * Ensure dyne_jobs_list can opt into published job content records.
 */
function _dyne_migrate_dynamic_jobs_list_field(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $storage = $entity_type_manager->getStorage('field_storage_config');
  $config = $entity_type_manager->getStorage('field_config');
  if (!$storage->load('paragraph.field_dynamic_jobs')) {
    $storage->create([
      'field_name' => 'field_dynamic_jobs',
      'entity_type' => 'paragraph',
      'type' => 'boolean',
      'settings' => [],
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }
  if (!$config->load('paragraph.dyne_jobs_list.field_dynamic_jobs')) {
    $config->create([
      'field_name' => 'field_dynamic_jobs',
      'entity_type' => 'paragraph',
      'bundle' => 'dyne_jobs_list',
      'label' => 'List published job records dynamically',
      'description' => 'Use published job content and group it by careers department instead of the static items JSON.',
      'required' => FALSE,
      'translatable' => FALSE,
      'default_value' => [['value' => 0]],
      'settings' => [],
    ])->save();
  }
  if (!$config->load('paragraph.dyne_jobs_list.field_body_text')) {
    $config->create([
      'field_name' => 'field_body_text',
      'entity_type' => 'paragraph',
      'bundle' => 'dyne_jobs_list',
      'label' => 'Section introduction',
      'description' => 'Optional introduction displayed above the job filters.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [],
    ])->save();
  }
  if (!$storage->load('paragraph.field_anchor')) {
    $storage->create([
      'field_name' => 'field_anchor',
      'entity_type' => 'paragraph',
      'type' => 'text',
      'settings' => ['max_length' => 64],
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }
  if (!$config->load('paragraph.dyne_jobs_list.field_anchor')) {
    $config->create([
      'field_name' => 'field_anchor',
      'entity_type' => 'paragraph',
      'bundle' => 'dyne_jobs_list',
      'label' => 'Section anchor id',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [],
    ])->save();
  }

  $form_display = EntityFormDisplay::load('paragraph.dyne_jobs_list.default');
  if (!$form_display) {
    $form_display = EntityFormDisplay::create([
      'targetEntityType' => 'paragraph',
      'bundle' => 'dyne_jobs_list',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $form_display->setComponent('field_dynamic_jobs', [
    'type' => 'boolean_checkbox',
    'weight' => 2,
    'settings' => ['display_label' => TRUE],
  ]);
  foreach ([
    'field_heading' => ['type' => 'string_textfield', 'weight' => 0],
    'field_anchor' => ['type' => 'string_textfield', 'weight' => 1],
    'field_body_text' => ['type' => 'text_textarea', 'weight' => 3],
    'field_items_json' => ['type' => 'string_textarea', 'weight' => 4],
  ] as $field_name => $component) {
    if ($config->load('paragraph.dyne_jobs_list.' . $field_name)) {
      $form_display->setComponent($field_name, $component);
    }
  }
  $form_display->save();

  $view_display = EntityViewDisplay::load('paragraph.dyne_jobs_list.default');
  if (!$view_display) {
    $view_display = EntityViewDisplay::create([
      'targetEntityType' => 'paragraph',
      'bundle' => 'dyne_jobs_list',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $hidden = $view_display->get('hidden') ?: [];
  $hidden = array_fill_keys(array_is_list($hidden) ? $hidden : array_keys($hidden), TRUE);
  unset($hidden['field_dynamic_jobs']);
  foreach ([
    'field_heading' => ['type' => 'string', 'label' => 'hidden', 'weight' => 0],
    'field_body_text' => ['type' => 'text_default', 'label' => 'hidden', 'weight' => 1],
    'field_items_json' => ['type' => 'string', 'label' => 'hidden', 'weight' => 2],
    'field_anchor' => ['type' => 'string', 'label' => 'hidden', 'weight' => 3],
  ] as $field_name => $component) {
    if ($config->load('paragraph.dyne_jobs_list.' . $field_name)) {
      $view_display->setComponent($field_name, $component);
      unset($hidden[$field_name]);
    }
  }
  $view_display->set('hidden', $hidden);
  $view_display->removeComponent('field_dynamic_jobs');
  $view_display->save();
}

/**
 * Ensure every custom Paragraph bundle has usable default field displays.
 */
function _dyne_migrate_paragraph_displays(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $paragraph_types = $entity_type_manager->getStorage('paragraphs_type')->loadMultiple();
  $field_storage = $entity_type_manager->getStorage('field_config');
  $widget_by_type = [
    'string' => 'string_textfield',
    'string_long' => 'string_textarea',
    'text' => 'text_textfield',
    'text_long' => 'text_textarea',
    'link' => 'link_default',
    'image' => 'image_image',
    'entity_reference' => 'entity_reference_autocomplete',
    'entity_reference_revisions' => 'entity_reference_paragraphs',
  ];
  $formatter_by_type = [
    'string' => 'string',
    'string_long' => 'string',
    'text' => 'text_default',
    'text_long' => 'text_default',
    'link' => 'link',
    'image' => 'image',
    'entity_reference' => 'entity_reference_label',
  ];

  foreach ($paragraph_types as $bundle => $paragraph_type) {
    $form_display_id = "paragraph.$bundle.default";
    $form_display = EntityFormDisplay::load($form_display_id);
    if (!$form_display) {
      $form_display = EntityFormDisplay::create([
        'targetEntityType' => 'paragraph',
        'bundle' => $bundle,
        'mode' => 'default',
        'status' => TRUE,
      ]);
    }

    $view_display_id = "paragraph.$bundle.default";
    $view_display = EntityViewDisplay::load($view_display_id);
    if (!$view_display) {
      $view_display = EntityViewDisplay::create([
        'targetEntityType' => 'paragraph',
        'bundle' => $bundle,
        'mode' => 'default',
        'status' => TRUE,
      ]);
    }

    $form_changed = FALSE;
    $view_changed = FALSE;
    $weight = 0;
    $hidden_form_fields = $form_display->get('hidden') ?: [];
    $hidden_view_fields = $view_display->get('hidden') ?: [];
    $hidden_form_names = array_fill_keys(array_is_list($hidden_form_fields) ? $hidden_form_fields : array_keys($hidden_form_fields), TRUE);
    $hidden_view_names = array_fill_keys(array_is_list($hidden_view_fields) ? $hidden_view_fields : array_keys($hidden_view_fields), TRUE);
    foreach ($field_storage->loadByProperties([
      'entity_type' => 'paragraph',
      'bundle' => $bundle,
    ]) as $field) {
      $field_name = $field->getName();
      $field_type = $field->getType();

      if ((!$form_display->getComponent($field_name) || isset($hidden_form_names[$field_name])) && isset($widget_by_type[$field_type])) {
        $form_display->setComponent($field_name, [
          'type' => $widget_by_type[$field_type],
          'weight' => $weight,
        ]);
        unset($hidden_form_names[$field_name]);
        $form_changed = TRUE;
      }

      if ((!$view_display->getComponent($field_name) || isset($hidden_view_names[$field_name])) && isset($formatter_by_type[$field_type])) {
        $view_display->setComponent($field_name, [
          'type' => $formatter_by_type[$field_type],
          'label' => 'hidden',
          'weight' => $weight,
        ]);
        unset($hidden_view_names[$field_name]);
        $view_changed = TRUE;
      }
      $weight++;
    }

    if ($form_changed) {
      $form_display->set('hidden', $hidden_form_names);
      $form_display->save();
    }
    if ($view_changed) {
      $view_display->set('hidden', $hidden_view_names);
      $view_display->save();
    }
  }
}

/**
 * Prepare existing content bundles for the public legacy archive import.
 */
function dyne_migrate_update_8108(): void {
  // The native upgrade supersedes sample-era menu and display configuration.
  if (_dyne_migrate_native_model_ready()) { return; }
  _dyne_migrate_legacy_schema();
}

/**
 * Additive schema setup; keep existing bundle names, fields and display choices.
 */
function _dyne_migrate_legacy_schema(): void {
  // Schema/display setup is one-time; subsequent imports preserve editor choices.
  if ((int) \Drupal::state()->get('dyne_migrate.legacy_schema_version', 0) >= 1) {
    return;
  }
  if (!\Drupal\filter\Entity\FilterFormat::load('dyne_legacy_html')) {
    \Drupal\filter\Entity\FilterFormat::create([
      'format' => 'dyne_legacy_html',
      'name' => 'Full HTML',
      'status' => TRUE,
      'weight' => 20,
      // Input is sanitized by the archive builder. Do not escape or rewrite its
      // layout classes. No role receives permission to use this format here.
      'filters' => [],
    ])->save();
  }
  foreach (['dyne_page', 'job', 'leader', 'perspective', 'news', 'pipeline_program'] as $bundle) {
    if (!NodeType::load($bundle)) {
      continue;
    }
    _dyne_migrate_ensure_shared_field('node', $bundle, 'field_body_text', ['text_long', [], 'Body text']);
    _dyne_migrate_ensure_shared_field('node', $bundle, 'field_legacy_title', ['string_long', [], 'Full legacy title']);
    _dyne_migrate_ensure_shared_field('node', $bundle, 'field_link', ['link', ['title' => 1, 'link_type' => 17], 'Source link']);
    _dyne_migrate_ensure_shared_field('node', $bundle, 'field_image', ['image', ['alt_field' => TRUE, 'file_directory' => 'legacy'], 'Image']);
    $display = EntityViewDisplay::load("node.$bundle.default") ?: EntityViewDisplay::create([
      'targetEntityType' => 'node', 'bundle' => $bundle, 'mode' => 'default', 'status' => TRUE,
    ]);
    $display->setComponent('field_body_text', ['type' => 'text_default', 'label' => 'hidden', 'weight' => 0]);
    $display->save();
    $form = EntityFormDisplay::load("node.$bundle.default") ?: EntityFormDisplay::create([
      'targetEntityType' => 'node', 'bundle' => $bundle, 'mode' => 'default', 'status' => TRUE,
    ]);
    $form->setComponent('field_body_text', ['type' => 'text_textarea', 'weight' => 20]);
    $form->setComponent('field_image', ['type' => 'image_image', 'weight' => 21]);
    $form->setComponent('field_link', ['type' => 'link_default', 'weight' => 22]);
    $form->setComponent('field_legacy_title', ['type' => 'string_textarea', 'weight' => 23]);
    if ($bundle === 'leader') {
      $form->setComponent('field_role', ['type' => 'string_textfield', 'weight' => 19]);
    }
    $form->save();
  }
  _dyne_migrate_ensure_shared_field('node', 'news', 'field_date_text', ['string', ['max_length' => 255], 'Publication date']);
  _dyne_migrate_ensure_shared_field('node', 'leader', 'field_role', ['string', ['max_length' => 255], 'Role']);
  _dyne_migrate_job_detail_fields();
  _dyne_migrate_dynamic_jobs_list_field();
  _dyne_migrate_paragraph_displays();
  $display = EntityViewDisplay::load('paragraph.dyne_rich_text.default');
  if ($display) {
    $display->setComponent('field_body_text', ['type' => 'text_default', 'label' => 'hidden', 'weight' => 0])->save();
  }
  \Drupal::state()->set('dyne_migrate.legacy_schema_version', 1);
}


/** Native migration has already applied the superseding field/display model. */
function _dyne_migrate_native_model_ready(): bool {
  $ledger = \Drupal::state()->get('dyne_migrate.native_content', []);
  return !empty($ledger['nodes'])
    && \Drupal\field\Entity\FieldConfig::loadByName('node', 'dyne_page', 'field_native_presentation')
    && \Drupal\field\Entity\FieldConfig::loadByName('paragraph', 'dyne_team_grid', 'field_team_members');
}

