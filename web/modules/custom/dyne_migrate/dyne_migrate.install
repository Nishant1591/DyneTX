use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;

/**
 * Implements hook_install().
 */
function dyne_migrate_install(): void {
  _dyne_migrate_site_settings();
  _dyne_migrate_vocabularies();
  _dyne_migrate_node_types();
  _dyne_migrate_paragraph_types();
  _dyne_migrate_fields();
  _dyne_migrate_job_detail_fields();
  _dyne_migrate_dynamic_jobs_list_field();
  _dyne_migrate_job_text_format();
  _dyne_migrate_paragraph_displays();
  _dyne_migrate_menus();
  _dyne_migrate_legacy_schema();
  require_once __DIR__ . '/includes/rich-text-editors.inc';
  dyne_migrate_enable_rich_text_editors();
  require_once __DIR__ . '/includes/title-aliases.inc';
  dyne_migrate_title_alias_schema();
  require_once __DIR__ . '/includes/pipeline-programs.inc';
  dyne_pipeline_program_model_schema();
  dyne_pipeline_component_schema();
  require_once __DIR__ . '/includes/image-library.inc';
  dyne_image_library_schema();
  require_once __DIR__ . '/includes/sitemap.inc';
  dyne_migrate_sitemap_setup();
  require_once __DIR__ . '/includes/live-content-reconciliation.inc';
  dyne_live_content_vacancy_schema();
  require_once __DIR__ . '/includes/perspective-list-model.inc';
  dyne_perspective_list_schema();
  require_once __DIR__ . '/includes/page-display.inc';
  dyne_page_display_schema();
}

/**
 * Implements hook_update_N().
 */
function dyne_migrate_update_8101(): void {
  _dyne_migrate_site_settings();
  _dyne_migrate_vocabularies();
  _dyne_migrate_node_types();
  _dyne_migrate_paragraph_types();
  _dyne_migrate_fields();
  _dyne_migrate_menus();
  _dyne_migrate_homepage();
}

/**
 * Site settings: name, frontpage.
 */
function _dyne_migrate_site_settings(): void {
  \Drupal::configFactory()->getEditable('system.site')
    ->set('name', 'Dyne Therapeutics')
    ->set('page.front', '/home')
    ->save();
}

/**
 * Vocabularies + seed terms observed on live site.
 */
function _dyne_migrate_vocabularies(): void {
  $vocabs = [
    'disease' => ['Disease', ['DMD', 'DM1', 'FSHD', 'Pompe']],
    'department' => ['Department', ['Platform', 'Quality', 'Regulatory', 'Clinical', 'Commercial', 'HR', 'Medical Affairs', 'Market Access', 'Procurement']],
    'job_location' => ['Job location', ['Waltham MA', 'Remote', 'Atlanta GA', 'Northeast Metro', 'West']],
    'story_type' => ['Story type', ['Perspective', 'Patient story', 'Culture']],
    'leader_type' => ['Leader type', ['Leadership', 'Board', 'SAB']],
  ];
  $ts = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach ($vocabs as $vid => [$label, $terms]) {
    if (!Vocabulary::load($vid)) {
      Vocabulary::create(['vid' => $vid, 'name' => $label])->save();
    }
    foreach ($terms as $name) {
      if (!$ts->loadByProperties(['vid' => $vid, 'name' => $name])) {
        $ts->create(['vid' => $vid, 'name' => $name])->save();
      }
    }
  }
}

/**
 * Node types.
 */
function _dyne_migrate_node_types(): void {
  $types = [
    'dyne_page' => ['Dyne page', 'Component-built marketing page (paragraphs).'],
    'job' => ['Job', 'Careers position.'],
    'leader' => ['Leader', 'Leadership / Board / SAB member.'],
    'perspective' => ['Perspective', 'Perspectives + patient stories.'],
    'news' => ['News', 'Latest news items.'],
    'pipeline_program' => ['Pipeline program', 'DMD / DM1 / FSHD program detail.'],
  ];
  foreach ($types as $type => [$label, $desc]) {
    if (!NodeType::load($type)) {
      NodeType::create(['type' => $type, 'name' => $label, 'description' => $desc])->save();
    }
  }
}

/**
 * Paragraph component types (one per live-site section pattern).
 */
function _dyne_migrate_paragraph_types(): void {
  $types = [
    'dyne_hero' => 'Hero banner',
    'dyne_icon_cards' => 'Icon card grid',
    'dyne_pipeline_table' => 'Pipeline table',
    'dyne_drug_detail' => 'Drug detail',
    'dyne_team_grid' => 'Team grid',
    'dyne_video' => 'Video lightbox',
    'dyne_quote_carousel' => 'Quote carousel',
    'dyne_jobs_list' => 'Jobs grouped list',
    'dyne_cta' => 'CTA band',
    'dyne_alert_banner' => 'Alert banner',
    'dyne_news_list' => 'News list',
    'dyne_rich_text' => 'Rich text section',
  ];
  foreach ($types as $id => $label) {
    if (!ParagraphsType::load($id)) {
      ParagraphsType::create(['id' => $id, 'label' => $label])->save();
    }
  }
}

/**
 * Field storage + field config per paragraph + node type.
 * Field names match the Twig templates exactly.
 */
function _dyne_migrate_fields(): void {
  $etm = \Drupal::entityTypeManager();
  $field_storage_storage = $etm->getStorage('field_storage_config');
  $field_config_storage = $etm->getStorage('field_config');

  // Shared fields: [id, type, settings, label]
  $shared = [
    // Text fields
    'field_title_line1'  => ['text',           ['max_length' => 255],             'Title line 1'],
    'field_title_line2'  => ['text',           ['max_length' => 255],             'Title line 2'],
    'field_heading'      => ['text',           ['max_length' => 255],             'Heading'],
    'field_banner_text'  => ['text_long',      [],                                'Banner text'],
    'field_body_text'    => ['text_long',      [],                                'Body text'],
    'field_style'        => ['text',           ['max_length' => 64],              'Style class'],
    'field_anchor'       => ['text',           ['max_length' => 64],              'Section anchor id'],
    'field_caption'      => ['text',           ['max_length' => 255],             'Caption'],
    'field_video_url'    => ['text',           ['max_length' => 2048],            'Video URL'],
    // JSON text fields
    'field_items_json'   => ['text_long',      [],                                'Items JSON'],
    'field_rows_json'    => ['text_long',      [],                                'Rows JSON'],
    'field_sections_json'=> ['text_long',      [],                                'Sections JSON'],
    // Link field
    'field_link'         => ['link',           ['title' => 'optional', 'external_link' => TRUE, 'placeholder_url' => 'Enter URL'], 'Link'],
    // Image fields
    'field_image'        => ['image',          ['file_directory' => 'field-images', 'max_resolution' => '', 'min_resolution' => '', 'alt_field' => TRUE, 'title_field' => FALSE], 'Image'],
    'field_poster'       => ['image',          ['file_directory' => 'field-posters', 'alt_field' => TRUE, 'title_field' => FALSE], 'Poster image'],
    'field_bg'           => ['image',          ['file_directory' => 'field-bg', 'alt_field' => TRUE, 'title_field' => FALSE], 'Background image'],
    'field_banner_logo'  => ['image',          ['file_directory' => 'field-logos', 'alt_field' => TRUE, 'title_field' => FALSE], 'Banner logo'],
    'field_icon'         => ['image',          ['file_directory' => 'field-icons', 'alt_field' => TRUE, 'title_field' => FALSE], 'Icon image'],
    // Entity reference (taxonomy term) fields
    'field_disease'      => ['entity_reference',['target_type' => 'taxonomy_term', 'handler' => 'default', 'handler_settings' => ['target_bundles' => ['disease']]], 'Disease'],
    'field_department'   => ['entity_reference',['target_type' => 'taxonomy_term', 'handler' => 'default', 'handler_settings' => ['target_bundles' => ['department']]], 'Department'],
    'field_location'     => ['entity_reference',['target_type' => 'taxonomy_term', 'handler' => 'default', 'handler_settings' => ['target_bundles' => ['job_location']]], 'Job location'],
    'field_leader_type'  => ['entity_reference',['target_type' => 'taxonomy_term', 'handler' => 'default', 'handler_settings' => ['target_bundles' => ['leader_type']]], 'Leader type'],
    // Entity reference revision for paragraph reference (components stack)
    'field_components'   => ['entity_reference_revisions',['target_type' => 'paragraph', 'handler' => 'default', 'handler_settings' => []], 'Components'],
  ];

  // Attach appropriate fields to each paragraph type (matching Twig templates).
  $p_types = [
    'dyne_hero', 'dyne_icon_cards', 'dyne_pipeline_table', 'dyne_drug_detail',
    'dyne_team_grid', 'dyne_video', 'dyne_quote_carousel', 'dyne_jobs_list',
    'dyne_cta', 'dyne_alert_banner', 'dyne_news_list', 'dyne_rich_text'
  ];
  $map = [
    'dyne_hero'          => ['field_title_line1', 'field_title_line2', 'field_banner_text'],
    'dyne_icon_cards'    => ['field_heading', 'field_items_json'],
    'dyne_pipeline_table'=> ['field_heading', 'field_rows_json'],
    'dyne_drug_detail'   => ['field_heading', 'field_body_text', 'field_sections_json'],
    'dyne_team_grid'     => ['field_heading', 'field_items_json', 'field_anchor'],
    'dyne_video'         => ['field_heading', 'field_video_url', 'field_poster', 'field_image'],
    'dyne_quote_carousel'=> ['field_heading', 'field_items_json'],
    'dyne_jobs_list'     => ['field_heading', 'field_items_json', 'field_anchor'],
    'dyne_cta'           => ['field_heading', 'field_body_text', 'field_link', 'field_bg'],
    'dyne_alert_banner'  => ['field_banner_text', 'field_banner_logo'],
    'dyne_news_list'     => ['field_heading', 'field_items_json'],
    'dyne_rich_text'     => ['field_heading', 'field_body_text', 'field_style', 'field_icon', 'field_link', 'field_anchor'],
  ];
  foreach ($p_types as $pt) {
    foreach ($map[$pt] as $fid) {
      _dyne_migrate_ensure_shared_field('paragraph', $pt, $fid, $shared[$fid]);
    }
  }

  $node_fields = [
    'dyne_page'         => ['field_components'],
    'job'               => ['field_body_text', 'field_link', 'field_department', 'field_location'],
    'leader'            => ['field_body_text', 'field_image', 'field_link', 'field_leader_type'],
    'perspective'       => ['field_body_text', 'field_image', 'field_link', 'field_disease'],
    'news'              => ['field_body_text', 'field_image', 'field_link'],
    'pipeline_program'  => ['field_body_text', 'field_image', 'field_link', 'field_disease'],
  ];
  foreach ($node_fields as $bundle => $fields) {
    foreach ($fields as $fid) {
      _dyne_migrate_ensure_shared_field('node', $bundle, $fid, $shared[$fid]);
    }
  }

}

/**
 * Create shared field storage/config using complete Drupal config entity IDs.
 */
function _dyne_migrate_ensure_shared_field(string $entity_type, string $bundle, string $name, array $definition): void {
  [$type, $settings, $label] = $definition;
  $storage_class = \Drupal\field\Entity\FieldStorageConfig::class;
  $config_class = \Drupal\field\Entity\FieldConfig::class;
  $storage = $storage_class::loadByName($entity_type, $name);
  if (!$storage) {
    $storage_settings = [];
    if (isset($settings['target_type'])) {
      $storage_settings['target_type'] = $settings['target_type'];
    }
    if (in_array($type, ['string', 'text'], TRUE) && isset($settings['max_length'])) {
      $storage_settings['max_length'] = $settings['max_length'];
    }
    $storage = $storage_class::create([
      'field_name' => $name,
      'entity_type' => $entity_type,
      'type' => $type,
      'settings' => $storage_settings,
      'cardinality' => $name === 'field_components' ? -1 : 1,
      'translatable' => FALSE,
    ]);
    $storage->save();
  }
  if (!$config_class::loadByName($entity_type, $bundle, $name)) {
    unset($settings['target_type'], $settings['max_length']);
    $config_class::create([
      'field_storage' => $storage,
      'bundle' => $bundle,
      'label' => $label,
      'settings' => $settings,
      'required' => FALSE,
      'translatable' => FALSE,
    ])->save();
  }
}

/**
 * Menus: main (primary nav) + footer (legal). Seed from live-site URL map.
 */
function _dyne_migrate_menus(): void {
  // A reconciled source menu supersedes the historical placeholder seed.
  if (\Drupal::state()->get('dyne_migrate.legacy_menu_hash')) {
    return;
  }
  $main_tree = [
    ['About Us', '/about-us', [
      ['Overview', '/about-us'],
      ['Leadership', '/about-us/leadership'],
      ['Board of directors', '/about-us/board-of-directors'],
      ['Scientific advisory board', '/about-us/scientific-advisory-board'],
      ['Corporate responsibility', '/about-us/corporate-responsibility'],
      ['Contact us', '/about-us/contact-us'],
    ]],
    ['FORCE Platform', '/our-forcetm-platform', [
      ['Overview', '/our-forcetm-platform'],
      ['Scientific publications & presentations', '/our-forcetm-publications'],
    ]],
    ['Pipeline', '/pipeline', [
      ['Overview', '/pipeline'],
      ['Zeleciment rostudirsen (DYNE-251)', '/dyne-251-for-dmd'],
      ['Zeleciment basivarsen (DYNE-101)', '/dyne-101-for-dm1'],
      ['DYNE-302', '/dyne-302-for-fshd'],
    ]],
    ['Physicians', '/physicians', [
      ['Commitment', '/our-commitment'],
      ['Clinical trials', '/clinical-trials'],
      ['DMD stories', '/dmd'],
      ['DM1 stories', '/dm1'],
      ['FSHD stories', '/fshd'],
    ]],
    ['Patients', '/patients', [
      ['Commitment', '/our-commitment'],
      ['Clinical trials', '/clinical-trials'],
      ['DMD stories', '/dmd'],
      ['DM1 stories', '/dm1'],
      ['FSHD stories', '/fshd'],
    ]],
    ['Investors & Media', '/investors', [
      ['Company overview', '/about-us'],
      ['News, publications & events', '/news'],
      ['Stock information', '/stock-information'],
      ['Corporate governance', '/corporate-governance'],
      ['Financials & filings', '/financials-filings'],
      ['IR resources', '/ir-resources'],
    ]],
    ['Culture & Careers', '/careers-culture', [
      ['Our culture & values', '/culture-values'],
      ['Hear from our Dynamos', '/dynamos'],
      ['Competitive benefits', '/benefits'],
      ['Open positions', '/jobs'],
    ]],
  ];

  $ms = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $existing = [];
  foreach ($ms->loadByProperties(['menu_name' => 'main']) as $m) {
    $existing[$m->get('title')->value] = $m;
  }

  $insert = function (array $tree, string $parent_title = '', int $weight = 0) use (&$existing, $ms, &$insert) {
    foreach ($tree as $item) {
      $title = $item[0];
      $path = $item[1];
      $children = isset($item[2]) ? $item[2] : [];
      $url = $path === '/' ? Url::fromRoute('<front>') : Url::fromUserInput($path);
      if (isset($existing[$title]) && $parent_title === '') {
        if ($children) { $insert($children, $title, $weight); }
        continue;
      }
      if (isset($existing[$title]) && $parent_title !== '') {
        if ($children) { $insert($children, $title, $weight); }
        continue;
      }
      $link = $ms->create([
        'title' => $title,
        'menu_name' => 'main',
        'link' => ['uri' => $url->toString(), 'options' => $url->getOptions()],
        'parent' => $parent_title ? 'main:' . $parent_title : '',
        'weight' => $weight++,
      ]);
      $link->save();
      $existing[$title] = $link;
      if ($children) { $insert($children, $title, $weight); }
    }
  };
  $insert($main_tree);

  // Footer legal menu.
  $footer_items = [
    ['Privacy Policy', '/privacy-policy'],
    ['Terms of Service', '/terms-of-service'],
    ['Consumer Health Data Policy', '/privacy-policy#dyne-consumer-health'],
  ];
  $fs = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  foreach ($footer_items as [$t, $u]) {
    if (!$fs->loadByProperties(['title' => $t, 'menu_name' => 'footer'])) {
      $url = $u === '/' ? Url::fromRoute('<front>') : Url::fromUserInput($u);
      $fs->create(['title' => $t, 'menu_name' => 'footer', 'link' => ['uri' => $url->toString(), 'options' => $url->getOptions()]])->save();
    }
  }
}

/**
 * Component homepage node (idempotent by title).
 */
function _dyne_migrate_homepage(): void {
  $ns = \Drupal::entityTypeManager()->getStorage('node');
  if ($ns->loadByProperties(['type' => 'dyne_page', 'title' => 'Home'])) { return; }
  $mk = function (string $type, array $fields): Paragraph {
    $p = Paragraph::create(['type' => $type] + $fields);
    $p->save();
    return $p;
  };
  $paras = [];
  // Hero
  $paras[] = $mk('dyne_hero', [
    'field_title_line1' => 'The muscle to',
    'field_title_line2' => 'keep life moving',
    'field_banner_text' => 'On September 7, we join the Duchenne community for World Duchenne Awareness Day, making a difference by focusing on therapies that are designed to deliver functional improvement for individuals living with DMD.',
  ]);
  // Rich text
  $paras[] = $mk('dyne_rich_text', [
    'field_heading' => 'Dyne Therapeutics is trailblazing the development of therapies to deliver functional improvement for people living with genetically driven neuromuscular diseases',
    'field_body_text' => ['value' => '<p>We are on a mission to deliver functional improvement for people living with genetically driven neuromuscular diseases through targeted therapies enabled by our FORCE platform. We have assembled an exceptional team with deep experience in neuromuscular disease, rare disorders, drug development, and manufacturing and commercialization of novel therapeutics. We have also established a scientific advisory board comprised of leading experts in neuromuscular disease drug discovery and development.</p>', 'format' => 'full_html'],
    'field_style' => 'h1-lede',
  ]);
  // Icon cards
  $paras[] = $mk('dyne_icon_cards', [
    'field_heading' => 'What we do',
    'field_items_json' => json_encode([
      ['icon' => '/themes/custom/dynetx/images/icons/ico-cells.svg', 'title' => 'Pioneering approach', 'text' => 'Utilizing our FORCE platform to develop therapeutics that address the root cause of disease.', 'link' => '/our-forcetm-platform', 'style' => 'red-one'],
      ['icon' => '/themes/custom/dynetx/images/icons/ico-muscle.svg', 'title' => 'Pipeline', 'text' => 'Developing a broad portfolio of therapeutics for genetically driven neuromuscular diseases', 'link' => '/pipeline', 'style' => 'blue-one'],
      ['icon' => '/themes/custom/dynetx/images/icons/ico-dna-vert.svg', 'title' => 'Find a Dyne clinical trial', 'text' => 'Conducting clinical trials for neuromuscular diseases', 'link' => '/clinical-trials', 'style' => 'mid-blue-one'],
      ['icon' => '/themes/custom/dynetx/images/icons/ico-commitment.svg', 'title' => 'Commitment', 'text' => 'Working to deliver functional improvement for people living with neuromuscular diseases', 'link' => '/our-commitment', 'style' => 'dark-gray-one'],
    ]),
  ]);
  // CTA
  $paras[] = $mk('dyne_cta', [
    'field_heading' => 'Culture and careers',
    'field_body_text' => ['value' => 'Our commitment to people living with neuromuscular diseases is our greatest strength. Hear our Dynamos share their perspective on what makes Dyne a special place to work.', 'format' => 'full_html'],
    'field_link' => ['uri' => 'internal:/careers-culture', 'title' => 'Learn more'],
  ]);
  // News list
  $paras[] = $mk('dyne_news_list', [
    'field_heading' => 'Latest news',
    'field_items_json' => json_encode([
      ['date' => 'September 08, 2026', 'title' => 'ACHIEVE Trial one-year data at medical meetings', 'url' => 'https://investors.dyne-tx.com/'],
      ['date' => 'September 03, 2026', 'title' => 'Preclinical DMD data at NMSG Scientific Meeting', 'url' => 'https://investors.dyne-tx.com/'],
    ]),
  ]);
  $refs = [];
  foreach ($paras as $p) { $refs[] = ['target_id' => $p->id(), 'target_revision_id' => $p->getRevisionId()]; }
  $node = Node::create(['type' => 'dyne_page', 'title' => 'Home', 'field_components' => $refs, 'uid' => 1]);
  $node->save();
  PathAlias::create(['path' => '/node/' . $node->id(), 'alias' => '/home'])->save();
}

/**
 * Implements hook_update_N().
 * Adds the field_anchor (section anchor id) field used by main-menu anchor
 * links (#leadership, #bod, #scientific, #contact, #dynamic, #benefits,
 * #positions, #dyne-consumer-health). Idempotent: re-runs _dyne_migrate_fields().
 */
function dyne_migrate_update_8102(): void {
  // The native upgrade supersedes sample-era menu and display configuration.
  if (_dyne_migrate_native_model_ready()) { return; }
  _dyne_migrate_fields();
  _dyne_migrate_menus();
}

