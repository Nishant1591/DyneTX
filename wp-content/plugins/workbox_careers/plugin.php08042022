	public function registerNewPostsTypes() {
		$labels = array(
			'name' => 'Jobs',
			'singular_name' => 'Job',
			'menu_name' => 'Jobs',
			'name_admin_bar' => 'Jobs',
			'add_new' => 'Add New Job',
			'add_new_item' => 'Add New Job',
			'new_item' => 'New Job',
			'edit_item' => 'Edit Job',
			'view_item' => 'View Job',
			'all_items' => 'All Jobs',
			'search_items' => 'Search Jobs',
			'parent_item_colon' => 'Parent Jobs:',
			'not_found' => 'No Jobs found.',
			'not_found_in_trash' => 'No Jobs found in Trash.',
